<!-- Version in English -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Post Details</title>
    <link href="/detailStyle.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="detail-container">
        <h1><%= post.title %></h1>

        <div class="post-info">
            <span><span class="info-label">Author:</span> <strong><%= post.authorName %></strong></span>
            <span><span class="info-label">Date:</span> <%= new Date(post.createdAt).toLocaleString() %></span>
            <span class="views"><span class="info-label">Views:</span> <%= post.views %></span>
        </div>

        <div class="post-content">
            <%= post.content %>
        </div>

        <div class="like-section">
            <% if (user) { %>
                <form action="/posts/<%= post._id %>/like" method="POST" class="like-form" id="likeForm-<%= post._id %>">
                    <button type="submit" class="like-btn <%= post.likes.includes(user._id) ? 'liked' : '' %>" id="likeBtn-<%= post._id %>">
                        <i class="fa-<%= post.likes.includes(user._id) ? 'solid' : 'regular' %> fa-heart"></i>
                        <span class="like-count" id="likeCount-<%= post._id %>"><%= post.likes.length %></span>
                        <span class="like-text"><%= post.likes.includes(user._id) ? 'Liked' : 'Like' %></span>
                    </button>
                </form>
            <% } else { %>
                <div class="like-section-login">
                    <i class="fa-regular fa-heart"></i>
                    <span class="like-count"><%= post.likes.length %></span>
                    <a href="/login" class="login-like">Login to like</a>
                </div>
            <% } %>
        </div>

        <div class="button-group">
            <a href="/posts" class="btn btn-list">List</a>

            <% if (user && user._id === post.author._id.toString()) { %>
                <div class="edit-delete-btn">
                    <a href="/posts/<%= post._id %>/edit" class="btn btn-edit">Edit</a>

                    <form action="/posts/<%= post._id %>/delete" method="POST" class="inline-form">
                        <button type="submit" class="btn btn-delete" onclick="return confirm('Are you sure you want to delete this post?')">
                            Delete
                        </button>
                    </form>
                </div>
            <% } %>
        </div>

        <div class="comments-section">
            <h2 class="comments-title">Comments</h2>

            <% if (user) { %>
                <div class="comment-form">
                    <form action="/posts/<%= post._id %>/comments" method="POST">
                        <textarea name="content" placeholder="Write your comment here..." required></textarea>
                        <button type="submit" class="btn btn-comment">Post Comment</button>
                    </form>
                </div>
            <% } else { %> 
                <p class="login-prompt">
                    Please <a href="/login" class="login-link">login</a> to write comments.
                </p>
            <% } %>

            <div class="comments-list">
                <% if (comments.length === 0) { %>
                    <p class="no-comments">No comments yet.</p>
                <% } else { %>
                    <% comments.forEach(comment => { %>
                        <div class="comment-item">
                            <div class="comment-header">
                                <span class="comment-author"><%= comment.authorName %></span>
                                <span class="comment-date"><%= new Date(comment.createdAt).toLocaleString() %></span>
                            </div>
                            <div class="comment-content">
                                <%= comment.content %>
                            </div>

                            <% if (user && user._id === comment.author.toString()) { %>
                                <div class="comment-delete-wrapper">
                                    <form action="/comments/<%= comment._id %>/delete" method="POST" class="inline-form">
                                        <button type="submit" class="comment-delete" onclick="return confirm('Delete this comment?')">Delete</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>    
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.like-form').forEach(form => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();

                const postId = form.action.split('/').slice(-2, -1)[0];
                const likeBtn = document.getElementById(`likeBtn-${postId}`);
                const likeCount = document.getElementById(`likeCount-${postId}`);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        likeCount.textContent = data.likeCount;
                        
                        if (data.liked) {
                            likeBtn.classList.add('liked');
                            likeBtn.querySelector('i').className = 'fa-solid fa-heart';
                            likeBtn.querySelector('.like-text').textContent = 'Liked';
                        } else {
                            likeBtn.classList.remove('liked');
                            likeBtn.querySelector('i').className = 'fa-regular fa-heart';
                            likeBtn.querySelector('.like-text').textContent = 'Like';
                        }
                    }
                } catch (err) {
                    console.error('Error:', err);
                }
            })
        })
    </script>
</body>
</html>